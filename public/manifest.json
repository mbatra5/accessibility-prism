{
  "manifest_version": 3,
  "name": "Accessibility Prism",
  "version": "3.0.1",
  "description": "All-in-one accessibility testing: axe scanning, keyboard & ARIA analysis, screen reader simulation, and visual overlays.",
  "permissions": ["activeTab", "scripting", "tabs", "windows"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Accessibility Prism",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "devtools_page": "devtools.html"
}
